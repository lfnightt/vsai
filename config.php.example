<?php
/**
 * API Configuration template — copy to config.php and fill in real values
 * (or set environment variables on Railway).
 *
 * On Railway set these env vars in the project settings:
 *   - API_BASE  : e.g. https://9router-production-aa27.up.railway.app/v1
 *   - API_KEY   : your secret API key (starts with sk-)
 *   - MODEL     : model identifier sent to the upstream API
 *   - ALLOWED_ORIGINS : comma-separated list of allowed origins (optional)
 *   - CHECK_REFERER : set to "false" to disable referer validation (optional)
 *   - RATE_LIMIT   : set to 0 to disable rate limiting (optional)
 *
 * ⚠️  SECURITY: Do NOT commit the real config.php to version control.
 */

return [
    // ── API Endpoint ──────────────────────────────────────────────
    'api_base'   => getenv('API_BASE') ?: 'https://9router-production-aa27.up.railway.app/v1',
    'api_path'   => '/chat/completions',

    // ── Authentication ──────────────────────────────────────────
    'api_key'    => getenv('API_KEY') ?: 'YOUR_API_KEY_HERE',

    // ── Model ────────────────────────────────────────────────────
    'model'      => getenv('MODEL') ?: 'OpenCode',

    // ── Security ─────────────────────────────────────────────────
    'allowed_origins' => array_filter(explode(',', getenv('ALLOWED_ORIGINS') ?: '')),
    'check_referer'   => (getenv('CHECK_REFERER') ?: 'true') !== 'false',
    'rate_limit'      => (int)(getenv('RATE_LIMIT') ?: 30),
    'require_session' => true,
];
